# Required: LLM API Key
OPENAI_API_KEY=your-api-key-here

# LLM Provider type: "openai" or "anthropic"
OPENAI_TYPE=openai

# Base URL (optional, for proxies/self-hosted)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model name (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# Use Anthropic as default provider (CLI only, set to "true" or "1")
# USE_ANTHROPIC=false

# Anthropic base URL (used when USE_ANTHROPIC=true)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Secondary Provider (optional) ---
# OPENAI_API_KEY_2=
# OPENAI_BASE_URL_2=
# OPENAI_MODEL_2=
# OPENAI_TYPE_2=openai
# OPENAI_SANITIZE_2=false

# --- Server Config ---
# API_TOKEN=your-fixed-token-here
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
