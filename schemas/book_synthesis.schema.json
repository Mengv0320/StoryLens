{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BookSynthesis",
  "description": "全书叙事综合分析，包含主线概要、支线追踪、伏笔追踪、角色弧线和节奏曲线",
  "type": "object",
  "required": ["title", "main_plotline", "subplot_summary", "foreshadowing_tracker", "character_arcs", "tension_curve", "themes", "open_questions", "quality_notes"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "description": "推断的书名或'未知书名'"
    },
    "main_plotline": {
      "type": "string",
      "description": "主线剧情完整概要（200-400字）"
    },
    "subplot_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["thread", "summary", "status"],
        "additionalProperties": false,
        "properties": {
          "thread": { "type": "string", "description": "支线名称" },
          "summary": { "type": "string", "description": "支线概要" },
          "status": {
            "type": "string",
            "enum": ["active", "resolved", "abandoned"],
            "description": "支线状态：active=进行中 resolved=已完结 abandoned=被遗忘"
          }
        }
      },
      "description": "支线剧情汇总"
    },
    "foreshadowing_tracker": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["setup", "setup_group"],
        "additionalProperties": false,
        "properties": {
          "setup": { "type": "string", "description": "伏笔描述" },
          "setup_group": { "type": "string", "description": "埋设伏笔的分组ID" },
          "resolved_group": {
            "type": ["string", "null"],
            "description": "回收伏笔的分组ID，null表示未回收"
          }
        }
      },
      "description": "跨组伏笔追踪"
    },
    "character_arcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "arc_summary", "key_moments"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "description": "角色名" },
          "arc_summary": { "type": "string", "description": "完整成长弧线（50-100字）" },
          "key_moments": {
            "type": "array",
            "items": { "type": "string" },
            "description": "关键时刻，格式：grp_XXX:事件描述"
          }
        }
      },
      "description": "重要角色弧线（≤10个）"
    },
    "tension_curve": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["group_id", "level", "reason"],
        "additionalProperties": false,
        "properties": {
          "group_id": { "type": "string", "description": "分组ID" },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "紧张度等级"
          },
          "reason": { "type": "string", "description": "简要原因" }
        }
      },
      "description": "全书节奏曲线，每组一条"
    },
    "themes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "核心主题"
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "全书未解悬念"
    },
    "quality_notes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "叙事质量备注（节奏失衡、支线断裂、伏笔遗忘等）"
    }
  }
}
