{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/causal_analysis.schema.json",
  "title": "CausalAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "causal_links",
    "foreshadowing",
    "chains"
  ],
  "properties": {
    "causal_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/causal_link"
      }
    },
    "foreshadowing": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/foreshadowing_item"
      }
    },
    "chains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/causal_chain"
      }
    }
  },
  "$defs": {
    "causal_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cause_event_id",
        "effect_event_id",
        "relation_type",
        "description"
      ],
      "properties": {
        "cause_event_id": {
          "type": "string",
          "minLength": 1
        },
        "effect_event_id": {
          "type": "string",
          "minLength": 1
        },
        "relation_type": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "foreshadowing_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "foreshadow_id",
        "setup_event_id",
        "description",
        "status"
      ],
      "properties": {
        "foreshadow_id": {
          "type": "string",
          "minLength": 1
        },
        "setup_event_id": {
          "type": "string",
          "minLength": 1
        },
        "payoff_event_id": {
          "type": ["string", "null"]
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "causal_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id",
        "title",
        "events",
        "chain_type",
        "status"
      ],
      "properties": {
        "chain_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "chain_type": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
