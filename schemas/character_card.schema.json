{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/character_card.schema.json",
  "title": "CharacterCard",
  "type": "object",
  "required": ["character_id", "canonical_name"],
  "properties": {
    "character_id": { "type": "string", "minLength": 1 },
    "canonical_name": { "type": "string", "minLength": 1 },
    "aliases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "identity": { "type": "string" },
    "stance": { "type": "string" },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/CharacterRelation" }
    },
    "recent_goals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "known_secrets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "first_appearance": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["active", "deceased", "departed", "unknown", "missing", "sealed", "dormant"]
    }
  },
  "$defs": {
    "CharacterRelation": {
      "type": "object",
      "required": ["target_character", "relation_type"],
      "properties": {
        "target_character": { "type": "string", "minLength": 1 },
        "relation_type": {
          "type": "string",
          "enum": ["ally", "enemy", "master_disciple", "lover", "rival", "family", "neutral", "friend", "subordinate", "superior"]
        },
        "description": { "type": "string" },
        "established_in": { "type": "string" }
      }
    }
  }
}
