{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EpisodeSummary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode_id",
    "title",
    "core_theme",
    "hook",
    "main_conflict",
    "key_events",
    "climax",
    "ending_hook",
    "episode_summary"
  ],
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "core_theme": {
      "type": "string",
      "minLength": 1
    },
    "hook": {
      "type": "string",
      "minLength": 1
    },
    "main_conflict": {
      "type": "string",
      "minLength": 1
    },
    "key_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "climax": {
      "type": "string",
      "minLength": 1
    },
    "ending_hook": {
      "type": "string",
      "minLength": 1
    },
    "episode_summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
