{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventScores",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "events"
  ],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scored_event"
      }
    }
  },
  "$defs": {
    "scored_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "main_plot_score",
        "character_relation_score",
        "status_shift_score",
        "climax_score",
        "suspense_score",
        "genre_value_score",
        "must_keep",
        "keep_reason"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "main_plot_score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "character_relation_score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "status_shift_score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "climax_score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "suspense_score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "genre_value_score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "must_keep": {
          "type": "boolean"
        },
        "keep_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
