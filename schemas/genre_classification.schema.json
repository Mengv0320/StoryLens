{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/genre_classification.schema.json",
  "title": "GenreClassification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "primary_genre",
    "subgenre",
    "secondary_genres",
    "confidence",
    "signals"
  ],
  "properties": {
    "primary_genre": {
      "type": "string",
      "enum": [
        "power_growth",
        "political_intrigue",
        "romance_relationship",
        "adventure_survival",
        "mystery_revelation",
        "career_reversal",
        "hybrid"
      ]
    },
    "subgenre": {
      "type": "string",
      "minLength": 1
    },
    "secondary_genres": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "power_growth",
          "political_intrigue",
          "romance_relationship",
          "adventure_survival",
          "mystery_revelation",
          "career_reversal",
          "hybrid"
        ]
      },
      "uniqueItems": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
