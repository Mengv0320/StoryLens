{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GenreClassification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "primary_genre",
    "subgenre",
    "secondary_genres",
    "confidence",
    "signals"
  ],
  "properties": {
    "primary_genre": {
      "type": "string",
      "minLength": 1
    },
    "subgenre": {
      "type": "string",
      "minLength": 1
    },
    "secondary_genres": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
