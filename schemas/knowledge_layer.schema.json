{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/knowledge_layer.schema.json",
  "title": "KnowledgeLayer",
  "type": "object",
  "required": ["characters", "factions", "world_setting", "timeline"],
  "properties": {
    "characters": {
      "type": "array",
      "items": { "$ref": "#/$defs/CharacterCard" }
    },
    "factions": {
      "type": "array",
      "items": { "$ref": "#/$defs/FactionCard" }
    },
    "world_setting": { "$ref": "#/$defs/WorldSetting" },
    "timeline": { "$ref": "#/$defs/PlotTimeline" }
  },
  "$defs": {
    "CharacterRelation": {
      "type": "object",
      "required": ["target_character", "relation_type"],
      "properties": {
        "target_character": { "type": "string", "minLength": 1 },
        "relation_type": {
          "type": "string",
          "enum": ["ally", "enemy", "master_disciple", "lover", "rival", "family", "neutral", "friend", "subordinate", "superior"]
        },
        "description": { "type": "string" },
        "established_in": { "type": "string" }
      }
    },
    "CharacterCard": {
      "type": "object",
      "required": ["character_id", "canonical_name"],
      "properties": {
        "character_id": { "type": "string", "minLength": 1 },
        "canonical_name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "identity": { "type": "string" },
        "stance": { "type": "string" },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/CharacterRelation" } },
        "recent_goals": { "type": "array", "items": { "type": "string" } },
        "known_secrets": { "type": "array", "items": { "type": "string" } },
        "first_appearance": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "FactionCard": {
      "type": "object",
      "required": ["faction_id", "name"],
      "properties": {
        "faction_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } },
        "stance": { "type": "string" },
        "goals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "LocationInfo": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "significance": { "type": "string" }
      }
    },
    "WorldSetting": {
      "type": "object",
      "properties": {
        "power_system": { "type": "string" },
        "locations": { "type": "array", "items": { "$ref": "#/$defs/LocationInfo" } },
        "rules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "TimelineEvent": {
      "type": "object",
      "required": ["event_id", "chapter"],
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "chapter": { "type": "string" },
        "description": { "type": "string" },
        "characters_involved": { "type": "array", "items": { "type": "string" } },
        "plot_significance": { "type": "string" }
      }
    },
    "SubplotIndex": {
      "type": "object",
      "required": ["subplot_id", "title"],
      "properties": {
        "subplot_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "related_characters": { "type": "array", "items": { "type": "string" } },
        "event_ids": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "minLength": 1 }
      }
    },
    "PlotTimeline": {
      "type": "object",
      "properties": {
        "main_plot_events": { "type": "array", "items": { "$ref": "#/$defs/TimelineEvent" } },
        "subplots": { "type": "array", "items": { "$ref": "#/$defs/SubplotIndex" } }
      }
    }
  }
}
