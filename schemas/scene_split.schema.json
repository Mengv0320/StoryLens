{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/scene_split.schema.json",
  "title": "SceneSplit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenes"
  ],
  "properties": {
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "start_hint",
        "end_hint",
        "location",
        "characters_present",
        "summary"
      ],
      "properties": {
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "start_hint": {
          "type": "string"
        },
        "end_hint": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "characters_present": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
